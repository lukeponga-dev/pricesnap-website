rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'developmentdesignsltd@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: Support Requests
    function isValidSupportRequest(data) {
      return data.keys().hasAll(['email', 'message', 'createdAt']) &&
             data.keys().hasOnly(['email', 'message', 'createdAt']) &&
             data.email is string && data.email.size() <= 128 &&
             data.message is string && data.message.size() <= 1024 &&
             data.createdAt is string;
    }

    // Validation Blueprint: Public Snaps
    function isValidPublicSnap(data) {
      return data.keys().hasAll(['itemName', 'condition', 'estimatedMin', 'estimatedMax', 'confidence', 'createdAt']) &&
             data.keys().hasOnly(['itemName', 'condition', 'estimatedMin', 'estimatedMax', 'confidence', 'createdAt']) &&
             data.itemName is string && data.itemName.size() <= 128 &&
             data.condition is string && data.condition.size() <= 64 &&
             data.estimatedMin is number &&
             data.estimatedMax is number &&
             data.confidence is number &&
             data.createdAt is string;
    }

    // Support Requests Rules
    match /supportRequests/{requestId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isValidId(requestId) && isValidSupportRequest(incoming());
    }

    // Public Snaps Rules
    match /publicSnaps/{snapId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(snapId) && (request.method == 'delete' || isValidPublicSnap(incoming()));
    }
  }
}
